# Server-only; never prefix these values with NEXT_PUBLIC_.
# Set a unique random password of at least 16 characters for /beheer.
JOURNEY_ADMIN_PASSWORD=

# Required in production; local `npm run dev` uses .journey-data/state.json if absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# One shared game for Matthew. Change this to start a separate, fresh game.
JOURNEY_GAME_ID=matthew
